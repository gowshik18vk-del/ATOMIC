{
  "name": "atomic-desktop-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Electron and TypeScript desktop assistant foundation.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/renderer/index.html','dist/renderer/index.html')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "dotenv": "^16.4.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
